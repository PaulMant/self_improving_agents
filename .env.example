ANTHROPIC_API_KEY=sk-ant-...

# LLM backend: "api" (Claude, default) or "ollama" (local)
LLM_BACKEND=api
OLLAMA_MODEL=qwen3:8b

# Knowledge base: absolute path to Paul's Lab (second brain).
# When set, agents use existing drafts and the living writing-style profile.
# Leave blank to run without the knowledge base (agents generate from scratch).
PAULS_LAB_PATH=/Users/yourname/path/to/Paul's Lab

# Reddit: optional — if set, posts will be submitted to r/forhire automatically
# Create app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
